# SQLite default for immediate local running without any setup
DATABASE_URL=sqlite:///./vtuwhatnow.db

# If using PostgreSQL or Supabase, uncomment and fill:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/vtuwhatnow

# VTU Semester Result Portal URLs (index.php is the form entry)
VTU_URL_SEM1=https://results.vtu.ac.in/D25J26Ecbcs/index.php
VTU_URL_SEM2=https://results.vtu.ac.in/MJ26cbcs/index.php

# Delay between student scrapes in seconds (to mimic human behavior)
DELAY_MIN=5
DELAY_MAX=10

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Admin panel protection password
ADMIN_PASSWORD=admin123

